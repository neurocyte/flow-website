#!/bin/sh
set -e
set -x

if [ -e public ]; then
    rm -r public
fi

zine release

# sign the installers
for installer in install install.ps1; do
    gpg --local-user 4E6CF7234FFC4E14531074F98EB1E1BB660E3FB9 \
        --detach-sign --armor --yes \
        --output "public/$installer.sig" "public/$installer"

    gpgv --keyring public/public.gpg --status-fd 1 \
        "public/$installer.sig" "public/$installer" |
        grep -q "^\[GNUPG:\] VALIDSIG .* 4E6CF7234FFC4E14531074F98EB1E1BB660E3FB9$"
done

rsync -avx --delete public/ flow-control.dev:/srv/flow-control.dev/html
