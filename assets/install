#!/bin/sh
set -e

install_dir="${PREFIX:-/usr/local}/bin"
add_alias=${ALIAS:-0}
nightly=${NIGHTLY:-0}
debug=${DEBUG:-0}
use_sudo=${USE_SUDO:-0}
force_update=${FORCE_UPDATE:-0}
no_gui=${NO_GUI:-0}
no_integrate=${NO_INTEGRATE:-0}
keyfile=${KEYFILE:-}
no_verify=${NO_VERIFY:-0}

# fingerprint of the key that signs flow releases and this script
key_fingerprint="4E6CF7234FFC4E14531074F98EB1E1BB660E3FB9"
key_url="https://flow-control.dev/public.gpg"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/flow"

usage() {
    echo "Options:"
    echo
    echo "  -a, --alias               Create/update 'f' alias"
    echo "  -n, --nightly             Latest nightly build"
    echo "  -D, --debug               Debug build"
    echo "  -d <path>, --dest <path>  Set install destination (default /usr/local/bin)"
    echo "  -k <file>, --key <file>   Verify with a local public key file instead"
    echo "                            of the one published on flow-control.dev"
    echo "      --no-verify           Install without verifying signatures"
    echo "  -F, --force               Force re-install even if flow is up-to-date"
    echo "  -G, --no-gui              Do not install flow-gui (implies --no-integrate)"
    echo "  -I, --no-integrate        Do not integrate flow-gui with the desktop"
    exit 1
}

while true; do
    case "${1}" in
    -a | --alias)
        add_alias=1
        shift 1
        ;;
    -n | --nightly)
        nightly=1
        shift 1
        ;;
    -D | --debug)
        debug=1
        shift 1
        ;;
    -d | --dest)
        install_dir=$2
        shift 2
        ;;
    -k | --key)
        keyfile=$2
        shift 2
        ;;
    --no-verify)
        no_verify=1
        shift 1
        ;;
    -F | --force)
        force_update=1
        shift 1
        ;;
    -G | --no-gui)
        no_gui=1
        shift 1
        ;;
    -I | --no-integrate)
        no_integrate=1
        shift 1
        ;;
    -h | --help)
        usage
        ;;
    --)
        shift 1
        break
        ;;
    "")
        break
        ;;
    *)
        echo error: Unknown argument "${1}"
        echo
        usage
        ;;
    esac
done

if [ "$no_gui" -eq 1 ]; then
    no_integrate=1
fi

# what was asked for, as opposed to what the archive turns out to support
want_no_gui=$no_gui
want_no_integrate=$no_integrate

have_term=0
if [ -t 0 ]; then
    have_term=1
fi

need_sudo=""
probe_dir="$install_dir"
while [ ! -e "$probe_dir" ]; do
    parent=$(dirname "$probe_dir")
    if [ "$parent" = "$probe_dir" ]; then
        break
    fi
    probe_dir="$parent"
done
if [ ! -w "$probe_dir" ]; then
    need_sudo="$probe_dir"
fi

if [ -z "$need_sudo" ] && [ -e "$install_dir/flow" ]; then
    if [ ! -w "$install_dir/flow" ]; then
        need_sudo="$install_dir/flow"
    fi
fi

if [ -z "$need_sudo" ] && [ -e "$install_dir/f" ]; then
    if [ ! -w "$install_dir/f" ]; then
        need_sudo="$install_dir/f"
    fi
fi

# prompt for nightly build option if interactive
if [ "$nightly" -eq 0 ] && [ "$have_term" -eq 1 ]; then
    printf "do you want to install a Nightly build? [y/N]: "
    read -r answer_nightly
    if [ "$answer_nightly" = "y" ] || [ "$answer_nightly" = "Y" ]; then
        nightly=1
    fi
fi

if [ "$debug" -eq 0 ] && [ "$have_term" -eq 1 ]; then
    printf "do you want to install a debug build? [y/N]: "
    read -r answer_debug
    if [ "$answer_debug" = "y" ] || [ "$answer_debug" = "Y" ]; then
        debug=1
    fi
fi

if [ ! "$(readlink "$install_dir/f")" = "$install_dir/flow" ]; then
    if [ "$have_term" -eq 1 ] && [ "$add_alias" -eq 0 ]; then
        printf "do you want to create an alias 'f' for 'flow'? [y/N]: "
        read -r answer_alias
        if [ "$answer_alias" = "y" ] || [ "$answer_alias" = "Y" ]; then
            add_alias=1
        fi
    fi
fi

if [ "$nightly" -eq 1 ]; then
    repo="neurocyte/flow-nightly"
    title="flow nightly build"
else
    repo="neurocyte/flow"
    title="flow"
fi

# detect os and architecture
os="$(uname -s | tr '[:upper:]' '[:lower:]')"
if [ "$os" = "darwin" ]; then
    os="macos"
fi

arch="$(uname -m)"
case "$arch" in
amd64) arch="x86_64" ;;
arm64) arch="aarch64" ;;
i686) arch="x86" ;;
i386) arch="x86" ;;
esac

# get latest version tag from github releases api
version=$(curl -s https://codeberg.org/api/v1/repos/$repo/releases/latest | jq -r .tag_name || echo null)
[ -z "$version" ] || [ "$version" = "null" ] && {
    version=$(curl -s "https://api.github.com/repos/$repo/releases/latest" | jq -r .tag_name || echo null)
    [ -z "$version" ] || [ "$version" = "null" ] && {
        version=$(curl -s https://git.flow-control.dev/api/v1/repos/$repo/releases/latest | jq -r .tag_name || echo null)
        [ -z "$version" ] || [ "$version" = "null" ] && {
            echo "failed to fetch $title latest version from github, codeberg or flow-control.dev"
            exit 1
        }
    }
}
title="$title $version"

if [ "$debug" -eq 1 ]; then
    title="$title (debug)"
fi

if [ "$force_update" -eq 0 ] && [ -e "$install_dir/flow" ]; then
    current_version=$(flow --version 2>/dev/null | grep version: | cut -f2 -d ' ')
    if [ "$current_version" = "$version" ]; then
        echo "flow is up-to-date (version $version @ $install_dir/flow)"
        exit 0
    else
        if [ -n "$current_version" ]; then
            echo "updating flow from $current_version to $version"
        fi
    fi
fi

if [ "$use_sudo" -eq 0 ] && [ -n "$need_sudo" ]; then
    printf "%s is not writable. Permissions will be requested with sudo.\n" "$need_sudo"
    use_sudo=1
fi

SUDOCMD=""
if [ -n "$need_sudo" ]; then
    if [ "$use_sudo" -eq 1 ]; then
        SUDOCMD=sudo
    else
        echo "error: '$need_sudo' is not writable."
        exit 1
    fi
fi

# construct download url
# note: nightly assets are named like "flow-<version>-<os>-<arch>.<ext>"
filename="flow-$version-$os-$arch"
ext="tar.gz"
if [ "$os" = "windows" ]; then
    ext="zip"
fi
if [ "$debug" -eq 1 ]; then
    filename="$filename-debug"
fi
url="https://codeberg.org/$repo/releases/download/$version/$filename.$ext"
url_gh="https://github.com/$repo/releases/download/$version/$filename.$ext"

tmp_path="$(mktemp -d "${TMPDIR:-/tmp}/flow-control-installer.XXXXXXXXX")"

if [ -z "$tmp_path" ] || [ "$tmp_path" = "/" ]; then
    echo "failed to create a temporary download directory"
    exit 1
fi

cleanup() {
    rm -Rf "$tmp_path"
    echo "removed temporary directory $tmp_path"
}

die() {
    exit 1
}

trap die INT
trap die HUP
trap die TERM
trap die QUIT
trap cleanup EXIT

# ---- signature verification -------------------------------------------------
#
# gpg --verify exits 0 for any good signature by any key in the keyring, so the
# key is pinned by matching the primary key fingerprint in the status output.
# VALIDSIG's last field is the primary key even when a subkey made the
# signature, which is what makes this survive a future signing subkey.
verify_sig() {
    verify_file=$1
    verify_sig_file=$2
    gpg --homedir "$tmp_path/gpg" --no-options --no-default-keyring \
        --keyring "$key_path" --status-fd 1 --batch \
        --verify "$verify_sig_file" "$verify_file" 2>/dev/null |
        grep -q "^\[GNUPG:\] VALIDSIG .* $key_fingerprint\$"
}

warn_unverified() {
    echo
    echo "########################################################################"
    echo "# WARNING: signature verification is disabled.                         #"
    echo "# Nothing was checked; the download is trusted on TLS alone.           #"
    echo "########################################################################"
    echo
}

# verification is mandatory unless it was explicitly turned off. a missing gpg
# is an error rather than a reason to continue unverified, so that removing gpg
# cannot silently downgrade an install
if [ "$no_verify" -eq 1 ]; then
    warn_unverified
elif ! command -v gpg >/dev/null 2>&1; then
    echo "error: gpg is required to verify the download, but was not found"
    echo
    echo "install gnupg and try again, or pass --no-verify to install without"
    echo "checking signatures"
    exit 1
fi

# the key is fetched, compared and stored even when this install is not
# verifying, so that update-flow has something to verify against. comparing
# and storing need curl and cmp, not gpg
key_path=""
stored_key="$state_dir/public.gpg"
if [ -n "$keyfile" ]; then
    if [ ! -e "$keyfile" ]; then
        echo "error: key file \"$keyfile\" not found"
        exit 1
    fi
    key_path="$keyfile"
    if [ "$no_verify" -eq 0 ]; then
        echo "verifying with $key_path"
    fi
else
    curl -fL "$key_url" -o "$tmp_path/public.gpg"
    # a key that has changed since the last install is treated like a changed
    # ssh host key: stop, and let the user decide what happened
    if [ -e "$stored_key" ] && ! cmp -s "$stored_key" "$tmp_path/public.gpg"; then
        echo "error: the public key at $key_url does not match $stored_key"
        echo
        echo "the signing key has changed since flow was last installed. this is"
        echo "expected after a key rotation, but it is also what a compromised"
        echo "download would look like. verify the new key before continuing:"
        echo
        echo "  gpg --show-keys --with-fingerprint $stored_key"
        echo
        echo "then remove $stored_key to accept the new key."
        exit 1
    fi
    key_path="$tmp_path/public.gpg"
fi

if [ "$no_verify" -eq 0 ]; then
    mkdir -p "$tmp_path/gpg"
    chmod 700 "$tmp_path/gpg"
fi

echo "downloading $title... to $tmp_path"

curl -fL "$url" -o "$tmp_path/$filename.$ext" || curl -fL "$url_gh" -o "$tmp_path/$filename.$ext"

# simple file size check (adjust threshold if needed)
filesize=$(stat -c%s "$tmp_path/$filename.$ext" 2>/dev/null || stat -f%z "$tmp_path/$filename.$ext")
if [ "$filesize" -lt 16384 ]; then
    echo "downloaded file appears to be invalid (size: ${filesize} bytes)"
    exit 1
fi

if [ "$no_verify" -eq 0 ]; then
    curl -fL "$url.sig" -o "$tmp_path/$filename.$ext.sig" ||
        curl -fL "$url_gh.sig" -o "$tmp_path/$filename.$ext.sig"
    if verify_sig "$tmp_path/$filename.$ext" "$tmp_path/$filename.$ext.sig"; then
        echo "good signature from $key_fingerprint"
    else
        echo "error: signature verification failed for $filename.$ext"
        echo "the download does not carry a valid signature from $key_fingerprint"
        exit 1
    fi
fi

unpack="$tmp_path/unpack"
mkdir -p "$unpack"
if [ "$ext" = "tar.gz" ]; then
    tar -xzf "$tmp_path/$filename.$ext" -C "$unpack"
else
    unzip -oq "$tmp_path/$filename.$ext" -d "$unpack"
fi

exe=""
if [ "$os" = "windows" ]; then
    exe=".exe"
fi

if [ ! -e "$unpack/flow$exe" ]; then
    echo "downloaded archive does not contain flow$exe"
    exit 1
fi

have_gui=0
if [ "$no_gui" -eq 0 ]; then
    if [ -e "$unpack/flow-gui$exe" ]; then
        have_gui=1
    else
        echo "note: this build does not include flow-gui"
        no_integrate=1
    fi
fi

install_binaries() {
    $SUDOCMD mkdir -p "$install_dir"
    $SUDOCMD cp "$unpack/flow$exe" "$install_dir/flow$exe"
    $SUDOCMD chmod +x "$install_dir/flow$exe"
    if [ "$have_gui" -eq 1 ]; then
        $SUDOCMD cp "$unpack/flow-gui$exe" "$install_dir/flow-gui$exe"
        $SUDOCMD chmod +x "$install_dir/flow-gui$exe"
    fi
}

integrate_macos() {
    bundle="$unpack/contrib/bundle"
    [ -d "$bundle" ] || return 1

    # prefer a bundle that is already installed
    app_root=""
    for candidate in "/Applications" "$HOME/Applications"; do
        if [ -d "$candidate/Flow Control.app" ] && [ -w "$candidate" ]; then
            app_root="$candidate"
            break
        fi
    done
    if [ -z "$app_root" ]; then
        app_root="/Applications"
        [ -w "$app_root" ] || app_root="$HOME/Applications"
    fi
    for other in "/Applications" "$HOME/Applications"; do
        if [ "$other" != "$app_root" ] && [ -d "$other/Flow Control.app" ]; then
            echo "WARNING: another installation exists at $other/Flow Control.app"
        fi
    done

    app="$app_root/Flow Control.app"

    mkdir -p "$app/Contents/MacOS"
    cp -R "$bundle/." "$app/"
    cp "$unpack/flow" "$unpack/flow-gui" "$app/Contents/MacOS/"
    chmod +x "$app/Contents/MacOS/flow" "$app/Contents/MacOS/flow-gui"
    sed "s/@VERSION@/${version#v}/g" "$bundle/Contents/Info.plist" >"$app/Contents/Info.plist"

    $SUDOCMD mkdir -p "$install_dir"
    $SUDOCMD ln -sf "$app/Contents/MacOS/flow" "$install_dir/flow"
    $SUDOCMD ln -sf "$app/Contents/MacOS/flow-gui" "$install_dir/flow-gui"

    lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
    [ -x "$lsregister" ] && "$lsregister" -f "$app" >/dev/null 2>&1

    echo "installed $app"
    echo "linked $install_dir/flow -> $app/Contents/MacOS/flow"
    return 0
}

integrate_desktop() {
    share="$unpack/contrib/share"
    [ -d "$share" ] || return 1

    case "$install_dir" in
    "$HOME"/*)
        data_dir="${XDG_DATA_HOME:-$HOME/.local/share}"
        data_sudo=""
        ;;
    *)
        data_dir="${install_dir%/bin}/share"
        data_sudo="$SUDOCMD"
        ;;
    esac

    $data_sudo mkdir -p "$data_dir"
    $data_sudo cp -R "$share/." "$data_dir/"
    sed "s|^Exec=.*|Exec=$install_dir/flow-gui %F|" \
        "$share/applications/flow-control.desktop" |
        $data_sudo tee "$data_dir/applications/flow-control.desktop" >/dev/null

    command -v update-desktop-database >/dev/null 2>&1 &&
        $data_sudo update-desktop-database "$data_dir/applications" >/dev/null 2>&1
    command -v gtk-update-icon-cache >/dev/null 2>&1 &&
        $data_sudo gtk-update-icon-cache -qtf "$data_dir/icons/hicolor" >/dev/null 2>&1

    echo "installed $data_dir/applications/flow-control.desktop"
    return 0
}

echo "installing $title to $install_dir/flow..."

if [ "$no_integrate" -eq 0 ] && [ "$os" = "macos" ]; then
    if ! integrate_macos; then
        echo "note: this build carries no macos bundle resources, installing binaries only"
        install_binaries
    fi
else
    install_binaries
    if [ "$no_integrate" -eq 0 ] && [ "$os" != "windows" ]; then
        integrate_desktop || echo "note: this build carries no desktop entry, skipping desktop integration"
    fi
fi

if [ "$add_alias" -eq 1 ]; then
    if [ "$(readlink "$install_dir/f")" = "$install_dir/flow" ]; then
        echo "alias $install_dir/f -> $install_dir/flow already exists"
    else
        if [ -e "$install_dir/f" ]; then
            echo "WARNING: existing file or alias detected at $install_dir/f, skipping alias creation..."
        else
            $SUDOCMD ln -s "$install_dir/flow" "$install_dir/f"
            echo "alias $install_dir/f -> $install_dir/flow created successfully"
        fi
    fi
fi

# keep the key, so that update-flow does not have to trust a freshly downloaded
# one, and so that a changed key is noticed on the next run
if [ -z "$keyfile" ]; then
    mkdir -p "$state_dir"
    cp "$key_path" "$state_dir/public.gpg"
fi

# record the options passed to this install, so that update-flow can repeat them
updater="$install_dir/update-flow"
{
    echo "#!/bin/sh"
    echo "# generated by the flow installer"
    echo "set -e"
    echo
    echo "fingerprint=\"$key_fingerprint\""
    # a --key install verifies against that file, so update-flow keeps using it
    if [ -n "$keyfile" ]; then
        echo "keyring=\"$keyfile\""
    else
        echo "keyring=\"$state_dir/public.gpg\""
    fi
    echo
    cat <<'UPDATER_BODY'
# --no-verify does not persist: it has to be asked for on every update
no_verify=0
for arg in "$@"; do
    case "$arg" in
    --no-verify) no_verify=1 ;;
    esac
done

tmp=$(mktemp -d "${TMPDIR:-/tmp}/flow-update.XXXXXXXXX")
trap 'rm -rf "$tmp"' EXIT
curl -fsSL https://flow-control.dev/install -o "$tmp/install"

if [ "$no_verify" -eq 1 ]; then
    echo
    echo "########################################################################"
    echo "# WARNING: signature verification is disabled.                         #"
    echo "# Nothing was checked; the download is trusted on TLS alone.           #"
    echo "########################################################################"
    echo
else
    if ! command -v gpg >/dev/null 2>&1; then
        echo "error: gpg is required to verify the installer, but was not found"
        echo
        echo "install gnupg and try again, or re-run with --no-verify to update"
        echo "without checking signatures"
        exit 1
    fi

    if [ ! -e "$keyring" ]; then
        echo "error: $keyring is missing"
        echo "re-install from https://flow-control.dev/install to restore it"
        exit 1
    fi

    curl -fsSL https://flow-control.dev/install.sig -o "$tmp/install.sig"

    mkdir -p "$tmp/gpg"
    chmod 700 "$tmp/gpg"
    if ! gpg --homedir "$tmp/gpg" --no-options --no-default-keyring \
        --keyring "$keyring" --status-fd 1 --batch \
        --verify "$tmp/install.sig" "$tmp/install" 2>/dev/null |
        grep -q "^\[GNUPG:\] VALIDSIG .* $fingerprint$"; then
        echo "error: the installer at flow-control.dev is not signed by $fingerprint"
        echo "refusing to run it"
        exit 1
    fi
fi
UPDATER_BODY
    echo
    if [ "$nightly" -eq 1 ]; then echo "export NIGHTLY=1"; fi
    if [ "$debug" -eq 1 ]; then echo "export DEBUG=1"; fi
    if [ "$add_alias" -eq 1 ]; then echo "export ALIAS=1"; fi
    if [ "$want_no_gui" -eq 1 ]; then echo "export NO_GUI=1"; fi
    if [ "$want_no_integrate" -eq 1 ]; then echo "export NO_INTEGRATE=1"; fi
    if [ -n "$keyfile" ]; then echo "export KEYFILE=\"$keyfile\""; fi
    echo "exec sh \"\$tmp/install\" --dest \"$install_dir\" \"\$@\""
} | $SUDOCMD tee "$updater" >/dev/null
$SUDOCMD chmod +x "$updater"
echo "installed $updater"

echo "$title installed successfully to $install_dir/flow"
